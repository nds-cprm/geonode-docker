# NOTE : $VARIABLES are env variables replaced by entrypoint.sh using envsubst
# not to be mistaken for nginx variables (also starting with $, but usually lowercase)

worker_processes auto;

# Rootless (nginx-unprivileged): pid e arquivos temporários em /tmp. A configuração gerada pelo
# entrypoint também fica em /tmp/nginx, para o /etc/nginx poder ser somente leitura.
pid /tmp/nginx.pid;

events {

}

http {
    # Temporários de resposta em disco, e não no tmpfs de /tmp (que ocupa RAM): o nginx lê a resposta
    # do Django/GeoServer na velocidade do disco e libera o worker do uWSGI ou a thread do Tomcat, em
    # vez de prendê-los pelo tempo de download de um cliente lento. Precisa ser gravável: no compose,
    # um volume por container (sem ele, com read_only, o nginx não sobe). O nginx apaga cada arquivo
    # logo depois de abri-lo, então nada sobra entre reinícios.
    proxy_temp_path       /var/cache/nginx/proxy_temp;
    client_body_temp_path /tmp/client_temp;
    fastcgi_temp_path     /tmp/fastcgi_temp;
    uwsgi_temp_path       /tmp/uwsgi_temp;
    scgi_temp_path        /tmp/scgi_temp;

    # Downloads simultâneos por IP nas rotas que entregam arquivos pelo Django (cada um ocupa um worker
    # do uWSGI enquanto o nginx lê a resposta). Fora delas a chave é vazia e não conta. O limite em si
    # (NGINX_DOWNLOADS_PER_IP) é gerado pelo entrypoint em /tmp/nginx/download-limit.conf.
    map $uri $download_limit_key {
        ~^/api/v2/assets/[0-9]+/download       $binary_remote_addr;
        ~^/documents/[0-9]+/(download|link)    $binary_remote_addr;
        ~^/datasets/[^/]+/dataset_download     $binary_remote_addr;
        default                                "";
    }
    limit_conn_zone $download_limit_key zone=downloads:10m;

    server_names_hash_bucket_size  64;
    http2 $HTTP2_TOGGLE;

    # Allow Nginx to resolve Docker host names (see https://sandro-keil.de/blog/2017/07/24/let-nginx-start-if-upstream-host-is-unavailable-or-down/)
    resolver $RESOLVER; # it seems rancher uses 169.254.169.250 instead of 127.0.0.11 which works well in docker-compose (see /etc/resolv.conf)

    # IP real do cliente atrás de proxy externo (gerado pelo entrypoint; vazio sem PROXY_TRUSTED_ADDRESSES)
    include /tmp/nginx/realip.conf;

    # https - listens on specific name - this uses letsencrypt cert
    # this includes a symlink that links either to nginx.https.available.conf if https in enabled
    # or to an empty file if https is disabled.
    include /tmp/nginx/nginx.https.enabled.conf;

    # http - listens to specific HTTP_HOST only - this is not encrypted (not ideal but admissible on LAN for instance)
    # even if not used (HTTP_HOST empty), we must keep it as it's used for internal API calls between django and geoserver
    # TODO : do not use unencrypted connection even on LAN, but is it possible to have browser not complaining about unknown authority ?
    server {
        listen              8080;
        server_name         $HTTP_HOST 127.0.0.1 $NGINX_EXTRA_SERVER_NAMES;

        include /tmp/nginx/sites-enabled/*.conf;
    }

    # Default server closes the connection (we can connect only using HTTP_HOST and HTTPS_HOST)
    server {
        listen          8080 default_server;
        listen          8443;
        server_name     _;
        return          444;
    }

}
